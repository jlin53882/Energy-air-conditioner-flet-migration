@echo off
chcp 65001 >nul
title 自動打卡服務 - 監控器 (可攜版)

:: =================================================================================
::  設定與檢查 (此版本設計為和 exe 放在同一個資料夾內)
:: =================================================================================

:: [修改] 因為此腳本和 exe 在同一層，直接使用 %~dp0 即可定位
set "EXE_PATH=%~dp0run.exe"

echo 監控目標程式: %EXE_PATH%
echo.

:: 在進入主循環前，先檢查目標程式是否存在
if not exist "%EXE_PATH%" (
    cls
    echo =================================================================
    echo  ❌ 錯誤：在目前資料夾找不到主程式！
    echo.
    echo  請確認 main.exe 和此腳本放在同一個資料夾內。
    echo =================================================================
    echo.
    pause
    exit /b
)

:: =================================================================================
::  主監控循環
:: =================================================================================

:start
cls
echo [%date% %time%] 正在啟動主程式...
echo.

"%EXE_PATH%"

echo.
echo [%date% %time%] 主程式已退出，返回碼 (Exit Code): %errorlevel%。
echo 將在 10 秒後重新啟動... (若要完全停止，請直接關閉此視窗)

timeout /t 10 >nul
goto start